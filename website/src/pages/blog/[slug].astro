---
import Base from '../../layouts/Base.astro';
import {posts} from '../../data/blog';
import {siteUrl} from '../../../site.config.mjs';
import '../../styles/blog.css';
export function getStaticPaths(){return posts.map(post=>({params:{slug:post.slug},props:{post}}));}
const {post}=Astro.props;const Content=post.Content;
const schema={'@context':'https://schema.org','@type':'BlogPosting',headline:post.title,description:post.description,datePublished:post.date,author:{'@type':'Person',name:post.author,url:'https://github.com/ashu4035'},mainEntityOfPage:new URL('/blog/'+post.slug+'/',siteUrl).href};
---
<Base title={post.title} description={post.description} section="blog"><article class="sl-container blog-shell blog-article"><a href="/blog/">← All articles</a><header class="blog-heading"><p class="blog-eyebrow">{post.category}</p><h1>{post.title}</h1><p>{post.description}</p><div class="blog-meta"><span>By {post.author}</span><time datetime={post.date}>{new Date(post.date+'T00:00:00Z').toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time><span>{post.readingTime}</span></div></header><div class="blog-prose"><Content/></div><footer class="blog-end"><a href="/components/">Explore the component library →</a></footer></article><script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\u003c')}/></Base>
