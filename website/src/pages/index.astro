---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Brand from '../components/Brand.astro';
import {components} from '../data/components';
import metrics from '../../../dist/size-report.json';
const size=(metrics.files['styloft.min.css'].gzipBytes/1000).toFixed(2);
const featured=['headers','cards','buttons','accordions','tables','animations'];
---
<Base>
  <section class="home-hero sl-container">
    <div class="hero-copy"><a class="release-pill" href="/getting-started/"><span>NEW</span> A fresh foundation for the web <span aria-hidden="true">↗</span></a><h1>Build lighter.<br/>Create <em>freely.</em><span class="hero-asterisk" aria-hidden="true">✳</span></h1><p>A modular CSS framework that gives your ideas room to breathe. Thoughtful defaults, flexible layouts, and zero runtime JavaScript.</p><div class="hero-actions sl-cluster sl-gap-4"><a class="sl-btn" href="/getting-started/">Start building <Icon name="arrow" size={18}/></a><a class="hero-secondary" href="/components/"><Icon name="grid" size={18}/> Explore components</a></div><div class="hero-footnote"><span><Icon name="check" size={14}/> No dependencies at runtime</span><span><Icon name="check" size={14}/> Yours to customize</span></div></div>
    <div class="hero-playground" aria-label="A composition of StyloftCSS cards, buttons, and design tokens">
      <div class="playground-grid" aria-hidden="true"></div><span class="playground-caption">THE COMPONENT PLAYGROUND</span>
      <div class="floating-note"><span class="tiny-dot"></span> Your ideas, beautifully structured.</div>
      <article class="hero-demo-card sl-card sl-stack"><div class="sl-cluster sl-justify-between"><div class="hero-brand-mark"><Brand markOnly/></div><span class="sl-badge">Made with Styloft</span></div><div class="hero-card-art" aria-hidden="true"><span></span><span></span><span></span><i>✳</i></div><div><p class="demo-kicker">A little inspiration</p><h2>A space to make<br/>something yours.</h2></div><p class="sl-text-muted">Start simple. Add your perspective.</p><a class="sl-btn sl-w-full" href="/components/cards/">Meet the components <span aria-hidden="true">↗</span></a></article>
      <div class="floating-palette"><span class="palette-label">YOUR PALETTE</span><div><i style="--swatch:#6857cf"></i><i style="--swatch:#bfb3ef"></i><i style="--swatch:#e6dcfa"></i><i style="--swatch:#edbfa4"></i><i style="--swatch:#e8e7e3"></i></div><span>One token. A whole new feeling.</span></div>
      <div class="floating-code"><span class="code-dot"></span><code>.sl-card <b>{'{'} padding: var(--sl-space-6); {'}'}</b></code><span class="code-caption">Small classes. Thoughtful defaults.</span></div>
      <span class="playground-coordinate" aria-hidden="true">01 — MAKE IT YOURS</span>
    </div>
  </section>
  <section class="metrics-band"><div class="sl-container metrics-inner"><div><strong>{size}<small> KB</small></strong><span>Measured core · gzip</span></div><div><strong>0<small> JS</small></strong><span>No runtime scripts</span></div><div><strong>6<small> layers</small></strong><span>A predictable cascade</span></div><div><strong>100<small>% yours</small></strong><span>Open source · MIT license</span></div></div></section>
  <section class="home-section sl-container"><div class="section-heading"><div><span class="eyebrow">Good defaults. Better possibilities.</span><h2>Everything you need.<br/><span>Room for everything else.</span></h2></div><p>Start with the foundation. Add the pieces that fit. Let your design take it from there.</p></div>
    <div class="principles sl-grid sl-md:cols-3 sl-gap-8">{[{icon:'layers',title:'A foundation, not a formula.',text:'Design tokens and cascade layers keep your decisions connected without locking you into one look.'},{icon:'grid',title:'Responsive by nature.',text:'Fluid type, flexible rows, and composable grids adapt to the space your content actually needs.'},{icon:'sun',title:'Considered from the start.',text:'Visible focus, semantic HTML, light and dark palettes, and respect for reduced-motion preferences.'}].map((item,i)=><article><span class="principle-number">0{i+1}</span><div class="principle-icon"><Icon name={item.icon} size={26}/></div><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
  </section>
  <section class="component-section"><div class="sl-container"><div class="section-heading"><div><span class="eyebrow">The component collection</span><h2>From a first impression<br/>to the finer details.</h2></div><a class="text-link" href="/components/">Browse all {components.length} categories <Icon name="arrow" size={18}/></a></div>
    <div class="home-components sl-grid sl-md:cols-3 sl-gap-6">
      {featured.map(slug=>{const c=components.find(c=>c.slug===slug)!;return <a href={`/components/${slug}/`} class={`component-tile tile-${slug}`}><div class="tile-art" aria-hidden="true">{slug==='headers'?<div class="mini-header"><b>s.</b><span></span><span></span><i>Start ↗</i></div>:slug==='cards'?<div class="mini-card"><div></div><b>A fresh perspective.</b><span></span><span></span></div>:slug==='buttons'?<div class="mini-buttons"><b>Make it yours ↗</b><span>A second option</span></div>:slug==='accordions'?<div class="mini-accordion"><b>A little more detail <i>−</i></b><span></span><span></span><b>What comes next? <i>+</i></b></div>:slug==='tables'?<div class="mini-table"><b>Project <i>Status</i></b><span>Studio notebook<i>Ready</i></span><span>Field notes<i>Draft</i></span></div>:<div class="mini-motion"><span>✳</span><b>A little movement.</b></div>}</div><div class="tile-description"><h3>{c.name}</h3><span aria-hidden="true">↗</span></div></a>})}
    </div>
  </div></section>
  <section class="home-section sl-container"><div class="build-section sl-grid sl-md:cols-2 sl-gap-12 sl-items-center"><div class="sl-stack sl-gap-6"><span class="eyebrow">From idea to interface</span><h2>Good HTML.<br/>A little CSS.<br/><span>You're on your way.</span></h2><p class="section-copy">No configuration maze. No application scanner. Link one stylesheet, compose a few classes, and focus on what you're making.</p><a class="text-link" href="/getting-started/">Your first five minutes <Icon name="arrow" size={18}/></a></div><div class="home-code"><div class="code-window-bar"><span><i></i><i></i><i></i></span><span>your-next-idea.html</span><Icon name="code" size={16}/></div><pre><code><span class="code-comment">&lt;!-- A foundation. Your imagination. --&gt;</span>{'\n'}&lt;<b>link</b> rel="stylesheet"{ '\n'}      href="styloft.min.css"&gt;{ '\n\n'}&lt;<b>div</b> class="sl-grid sl-md:cols-3"&gt;{ '\n'}  &lt;<b>article</b> class="sl-card sl-stack"&gt;{ '\n'}    &lt;<b>h2</b>&gt;Hello, possibility.&lt;/<b>h2</b>&gt;{ '\n'}    &lt;<b>p</b>&gt;Your idea goes here.&lt;/<b>p</b>&gt;{ '\n'}  &lt;/<b>article</b>&gt;{ '\n'}&lt;/<b>div</b>&gt;</code></pre><div class="code-window-foot"><span class="tiny-dot"></span> Plain HTML. Real possibilities.</div></div></div></section>
  <section class="theme-teaser sl-container"><div class="theme-copy"><span class="eyebrow">A change of atmosphere</span><h2>One system.<br/>Your spectrum.</h2><p>From a bright beginning to a quieter canvas. Semantic tokens keep your whole interface in tune.</p><a class="text-link" href="/themes/">Explore tokens & themes <Icon name="arrow" size={18}/></a></div><div class="theme-pair"><div data-theme="light" class="sl-card sl-stack"><span class="sl-badge">Light</span><h3>A fresh start.</h3><p class="sl-text-muted">Room to think.</p><a class="sl-btn" href="/themes/">Explore ↗</a></div><div data-theme="dark" class="sl-card sl-stack"><span class="sl-badge">Dark</span><h3>A quiet canvas.</h3><p class="sl-text-muted">Space to focus.</p><a class="sl-btn" href="/themes/">Explore ↗</a></div></div></section>
  <section class="final-cta sl-container"><span class="cta-spark" aria-hidden="true">✳</span><span class="eyebrow">Your next idea starts here</span><h2>A small stylesheet.<br/>A wide-open canvas.</h2><div class="sl-cluster sl-justify-center sl-gap-4"><a class="sl-btn" href="/getting-started/">Let's build something <Icon name="arrow" size={18}/></a><a href="/downloads/styloft.min.css" class="download-link" download><Icon name="download" size={18}/> Download CSS</a></div><p>CSS only. Open source. Made for the web.</p></section>
</Base>
