---
import {siteUrl} from '../../site.config.mjs';
import Icon from '../components/Icon.astro';
import Brand from '../components/Brand.astro';
import {getImage} from 'astro:assets';
import mark from '../assets/brand-mark.png';
import '../../../dist/styloft.css';
import '../../../src/modules/prose.css';
import '../../../src/modules/tables.css';
import '../../../src/modules/variants.css';
import '../../../src/modules/responsive.css';
import '../../../src/modules/motion.css';
import '../../../src/modules/button-fx.css';
import '../../../src/modules/slider.css';
import '../../../src/modules/editor.css';
import '../../../src/modules/header.css';
import '../../../src/modules/cursor.css';
import '../../../src/modules/select.css';
import '../../../src/modules/tabs.css';
import '../../../src/modules/collections.css';
import '../../../src/modules/fields.css';
import '../../../src/modules/colors.css';
import '../../../src/modules/dates.css';
import '../../../src/modules/overlays.css';
import '../../../src/modules/status.css';
import '../../../src/modules/media.css';
import '../../../src/modules/navigation.css';
import '../../../src/modules/surfaces.css';
import '../styles/site.css';
import '../styles/themes.css';
import '../styles/motion.css';
import '../styles/catalog.css';
import '../styles/code-editor.css';
import '../styles/typography.css';
import '../styles/fonts.css';
import '../styles/documentation-tools.css';
import '../styles/navigation-polish.css';
import fontFiles from '../../public/fonts/manifest.json';
const { title='Lightweight CSS Framework & Components', description='A modular CSS framework with zero runtime JavaScript. Explore live StyloftCSS components, layouts, and themes.', section='home' }=Astro.props;
const isLight=Astro.url.pathname.startsWith('/light/');
const theme=isLight?'light':'dark';
const pathWithoutTheme=Astro.url.pathname.replace(/^\/light(?=\/)/,'');
const darkPath=/^\/404(?:\.html)?\/?$/.test(pathWithoutTheme)?'/404.html':pathWithoutTheme;
const togglePath=isLight?darkPath:(darkPath==='/404.html'?'/light/404/':`/light${darkPath}`);
const canonical=new URL(darkPath,siteUrl).href;
const isError=/^\/404(?:\.html)?\/?$/.test(darkPath);
const pageTitle=darkPath==='/'?'StyloftCSS — '+title:title+' — StyloftCSS';
const socialImage=new URL('/social-preview.png',siteUrl).href;
const structuredData={'@context':'https://schema.org','@graph':[
  {'@type':'WebSite','@id':siteUrl+'/#website',name:'StyloftCSS',alternateName:['Styloft CSS','styloftcss.pages.dev'],url:siteUrl+'/',description:'A modular CSS framework with zero runtime JavaScript.',inLanguage:'en'},
  {'@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:pageTitle,description,isPartOf:{'@id':siteUrl+'/#website'},inLanguage:'en'},
  ...(darkPath==='/'?[{'@type':'SoftwareSourceCode',name:'StyloftCSS',description:'A modular CSS framework with CSS-only components, design tokens and optional component packs.',codeRepository:'https://github.com/ashu4035/StyloftCSS',programmingLanguage:'CSS',license:'https://opensource.org/license/mit',author:{'@type':'Person',name:'Ashish Verma',url:'https://github.com/ashu4035'}}]:[])
]};
const favicon=await getImage({src:mark,width:64,height:64,fit:'contain',format:'png'});
---
<!doctype html>
<html lang="en" data-theme={theme}>
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  {fontFiles.filter(f=>(f.family==='Clash Display'&&f.weight==='600')||(f.family==='Switzer'&&f.weight==='400')).map(f=><link rel="preload" href={'/fonts/'+f.file} as="font" type="font/woff2" crossorigin/>)}
  <link rel="canonical" href={canonical}/>
  <meta name="robots" content={isError?'noindex, follow':'index, follow, max-image-preview:large'}/>
  <meta property="og:type" content="website"/>
  <meta property="og:site_name" content="StyloftCSS"/>
  <meta property="og:title" content={pageTitle}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:image" content={socialImage}/>
  <meta property="og:image:alt" content="StyloftCSS — Style more. Load less."/>
  <meta name="twitter:card" content="summary"/>
  <meta name="twitter:title" content={pageTitle}/>
  <meta name="twitter:description" content={description}/>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g,'\\u003c')}/>
  <title>{pageTitle}</title><meta name="description" content={description}/>
  <meta name="author" content="Ashish Verma"/>
  <meta name="theme-color" content={isLight?'#f7fafc':'#060b16'}/>
  <link rel="icon" type="image/png" href={favicon.src}/>
  {import.meta.env.PROD && <>
    <script is:inline async data-styloft-analytics="loader" src="https://www.googletagmanager.com/gtag/js?id=G-FXJQZFLQF5"></script>
    <script is:inline data-styloft-analytics="config">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FXJQZFLQF5');
    </script>
  </>}
</head>
<body class="site-cursor">
  <a class="sl-skip sl-btn" href="#main">Skip to content</a>
  <div class="announcement"><span class="announcement-dot"></span> Introducing StyloftCSS 0.1 <span class="announcement-divider">/</span> A small foundation for your next big idea. <a href="/getting-started/">Meet the framework <span aria-hidden="true">↗</span></a></div>
  <header class="site-header"><nav class="sl-container header-inner" aria-label="Main navigation">
    <Brand/>
    <div class="desktop-nav"><a href="/blog/" aria-current={section==='blog'?'page':undefined}>Blog</a><a href="/search/">Search</a><a href="/getting-started/" aria-current={section==='docs'?'page':undefined}>Documentation</a><a href="/components/" aria-current={section==='components'?'page':undefined}>Components</a><a href="/layouts/" aria-current={section==='layouts'?'page':undefined}>Layouts</a><a href="/themes/" aria-current={section==='themes'?'page':undefined}>Themes</a></div>
    <div class="header-actions"><a data-theme-switch class="mode-switch" href={togglePath} aria-label={`Switch to ${isLight?'dark':'light'} mode`} title={`Switch to ${isLight?'dark':'light'} mode`}><Icon name={isLight?'moon':'sun'} size={18}/><span>{isLight?'Dark':'Light'}</span></a><a class="header-cta sl-btn" href="/getting-started/">Start building <Icon name="arrow" size={16}/></a></div>
    <details class="mobile-nav"><summary aria-label="Navigation menu"><span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span></summary><div><a href="/blog/">Blog</a><a href="/search/">Search documentation</a><a href="/getting-started/">Documentation</a><a href="/components/">Components</a><a href="/layouts/">Layouts</a><a href="/themes/">Themes</a></div></details>
  </nav></header>
  <main id="main" tabindex="-1"><slot/></main>
  <footer class="site-footer"><div class="sl-container"><div class="footer-top sl-grid sl-md:cols-3 sl-gap-12"><div class="sl-stack"><Brand/><p>Style more.<br/>Load less.</p><span class="footer-version">v0.1.0 · Open source · MIT</span><a class="footer-repository" href="https://github.com/ashu4035/StyloftCSS" target="_blank" rel="noopener noreferrer">GitHub repository ↗</a></div><div><h2>Build something</h2><a href="/blog/">Blog</a><a href="/tutorials/">CSS tutorials</a><a href="/guides/">Guides &amp; releases</a><a href="/search/">Search CSS classes</a><a href="/getting-started/">Getting started</a><a href="/components/">Component library</a><a href="/layouts/">Layout patterns</a><a href="/themes/">Design tokens & themes</a></div><div><h2>Make it yours</h2><a href="/downloads/styloft.min.css" download>Download core CSS</a><a href="/downloads/prose.min.css" download>Download prose module</a><a href="/downloads/tables.min.css" download>Download tables module</a><a href="/downloads/size-report.json">Measured size report</a></div></div><div class="footer-bottom"><p>© 2026 StyloftCSS contributors. MIT licensed.</p><p>StyloftCSS created by <a class="footer-author" href="https://github.com/ashu4035" rel="author">Ashish Verma</a>.</p><a href="#main">Back to top ↑</a></div></div></footer>
  <script>import '../scripts/site-tools';</script>
</body>
</html>
