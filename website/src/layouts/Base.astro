---
import Icon from '../components/Icon.astro';
import Brand from '../components/Brand.astro';
import {getImage} from 'astro:assets';
import mark from '../assets/brand-mark.png';
import '../../../dist/styloft.css';
import '../../../src/modules/prose.css';
import '../../../src/modules/tables.css';
import '../../../src/modules/variants.css';
import '../../../src/modules/responsive.css';
import '../../../src/modules/motion.css';
import '../../../src/modules/button-fx.css';
import '../../../src/modules/slider.css';
import '../../../src/modules/editor.css';
import '../../../src/modules/header.css';
import '../../../src/modules/cursor.css';
import '../../../src/modules/select.css';
import '../../../src/modules/tabs.css';
import '../styles/site.css';
import '../styles/themes.css';
import '../styles/motion.css';
import '../styles/catalog.css';
import '../styles/code-editor.css';
const { title='Build lighter. Create freely.', description='A modular CSS framework with zero runtime JavaScript. Explore live StyloftCSS components, layouts, and themes.', section='home' }=Astro.props;
const isLight=Astro.url.pathname.startsWith('/light/');
const theme=isLight?'light':'dark';
const pathWithoutTheme=Astro.url.pathname.replace(/^\/light(?=\/)/,'');
const darkPath=/^\/404(?:\.html)?\/?$/.test(pathWithoutTheme)?'/404.html':pathWithoutTheme;
const togglePath=isLight?darkPath:(darkPath==='/404.html'?'/light/404/':`/light${darkPath}`);
const favicon=await getImage({src:mark,width:64,height:64,fit:'contain',format:'png'});
---
<!doctype html>
<html lang="en" data-theme={theme}>
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <link rel="preconnect" href="https://api.fontshare.com"/>
  <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin/>
  <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600,700&amp;display=swap"/>
  <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,600,700&amp;display=swap"/>
  <title>{title} — StyloftCSS</title><meta name="description" content={description}/>
  <meta name="author" content="Ashish Verma"/>
  <meta name="theme-color" content={isLight?'#f7fafc':'#060b16'}/>
  <link rel="icon" type="image/png" href={favicon.src}/>
</head>
<body class="sl-cursor-site sl-cursor-pulse">
  <a class="sl-skip sl-btn" href="#main">Skip to content</a>
  <div class="announcement"><span class="announcement-dot"></span> Introducing StyloftCSS 0.1 <span class="announcement-divider">/</span> A small foundation for your next big idea. <a href="/getting-started/">Meet the framework <span aria-hidden="true">↗</span></a></div>
  <header class="site-header"><nav class="sl-container header-inner" aria-label="Main navigation">
    <Brand/>
    <div class="desktop-nav"><a href="/getting-started/" aria-current={section==='docs'?'page':undefined}>Documentation</a><a href="/components/" aria-current={section==='components'?'page':undefined}>Components</a><a href="/layouts/" aria-current={section==='layouts'?'page':undefined}>Layouts</a><a href="/themes/" aria-current={section==='themes'?'page':undefined}>Themes</a></div>
    <div class="header-actions"><a data-theme-switch class="mode-switch" href={togglePath} aria-label={`Switch to ${isLight?'dark':'light'} mode`} title={`Switch to ${isLight?'dark':'light'} mode`}><Icon name={isLight?'moon':'sun'} size={18}/><span>{isLight?'Dark':'Light'}</span></a><a class="header-cta sl-btn" href="/getting-started/">Start building <Icon name="arrow" size={16}/></a></div>
    <details class="mobile-nav"><summary aria-label="Open navigation">Menu <span aria-hidden="true">+</span></summary><div><a href="/getting-started/">Documentation</a><a href="/components/">Components</a><a href="/layouts/">Layouts</a><a href="/themes/">Themes</a></div></details>
  </nav></header>
  <main id="main" tabindex="-1"><slot/></main>
  <footer class="site-footer"><div class="sl-container"><div class="footer-top sl-grid sl-md:cols-3 sl-gap-12"><div class="sl-stack"><Brand/><p>Style more.<br/>Load less.</p><span class="footer-version">v0.1.0 · Open source · MIT</span><a class="footer-repository" href="https://github.com/ashu4035/StyloftCSS" target="_blank" rel="noopener noreferrer">GitHub repository ↗</a></div><div><h2>Build something</h2><a href="/getting-started/">Getting started</a><a href="/components/">Component library</a><a href="/layouts/">Layout patterns</a><a href="/themes/">Design tokens & themes</a></div><div><h2>Make it yours</h2><a href="/downloads/styloft.min.css" download>Download core CSS</a><a href="/downloads/prose.min.css" download>Download prose module</a><a href="/downloads/tables.min.css" download>Download tables module</a><a href="/downloads/size-report.json">Measured size report</a></div></div><div class="footer-bottom"><p>© 2026 StyloftCSS contributors. MIT licensed.</p><p>StyloftCSS created by <a class="footer-author" href="https://github.com/ashu4035" rel="author">Ashish Verma</a>.</p><a href="#main">Back to top ↑</a></div></div></footer>
</body>
</html>
